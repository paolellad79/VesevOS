# Scheda periferica VesevOS (dati propri, licenza CC0). Controlla sempre i collegamenti sul datasheet del tuo modulo.
# Stato: FUNZIONA (classe analogico, gia supportata dal firmware).
# Modulo tipico: fotoresistenza (LDR) con resistenza da 10 kohm in partitore, 3 pin: VCC, GND, A0 (a volte S/-/+).
#
# FILI ([pins]: pin del modulo = dove va sulla scheda, colore del filo)
#   VCC  -> 3V3                      rosso   (alimentazione)
#   GND  -> GND                      nero    (massa)
#   A0   -> un pin analogico libero  azzurro (segnale)
# Pin analogici ammessi: solo GPIO 1-10 (gli altri disturbano il Wi-Fi). Il firmware propone il primo libero.
[module]
name=ldr
title=Sensore di luce LDR
class=analogico
power=3V3
level=3V3
part=gnd,10 kohm,A0
author=VesevOS
version=1.1
license=CC0
warn=Partitore con 10 kohm; non superare 3,3 V sul pin
[signals]
A0
[pins]
VCC=vcc,red
GND=gnd,black
A0=A0,cyan
[icon]
<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" fill="none" stroke="#d4a017" stroke-width="2"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" stroke="#d4a017" stroke-width="2"/></svg>
