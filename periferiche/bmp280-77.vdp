# Scheda periferica VesevOS (dati propri, licenza CC0). Controlla sempre i collegamenti sul datasheet del tuo modulo.
# Stato: FUNZIONA dalla 1.7.61 (classe i2c, driver bmp280 nel firmware): temperatura e pressione. Da provare su un modulo vero.
# Modulo a 4 pin: VDD (o VCC), SDA, GND, SCL. Indirizzo 0x77 (SDO a VCC). Per 0x76 (SDO a massa) usa bmp280.vdp.
# Molti moduli sono a 3,3 V; alcuni hanno un regolatore e accettano 5 V: leggi la scheda del produttore. Le resistenze di pull-up sono quasi sempre sul modulo.
# Pin proposti dalla scheda: SDA = GPIO8, SCL = GPIO9 (se liberi).
#
# FILI ([pins]: pin del modulo = dove va sulla scheda, colore del filo)
#   VDD  -> 3V3    rosso   (alimentazione)
#   SDA  -> SDA    verde   (dati)
#   GND  -> GND    nero    (massa)
#   SCL  -> SCL    giallo  (clock)
[module]
name=bmp280-77
title=Sensore BMP280 (0x77)
class=i2c
driver=bmp280
addr=0x77
power=3V3
level=3V3
author=VesevOS
version=2.0
license=CC0
warn=Controlla se il modulo e a 3,3 V; temperatura e pressione, indirizzo 0x77
[signals]
SDA
SCL
[pins]
VDD=vcc,red
SDA=SDA,green
GND=gnd,black
SCL=SCL,yellow
[icon]
<svg viewBox="0 0 24 24"><rect x="4" y="6" width="16" height="12" rx="2" fill="none" stroke="#7a3fa0" stroke-width="2"/><path d="M8 18v3M12 18v3M16 18v3" stroke="#7a3fa0" stroke-width="2"/></svg>
