# VesevOS - configurazione per ESP32-C3 SuperMini (13/11/2026). SOLO FILE: NON configurato ne compilato con IDF, nessuna prova su scheda.
# Copia di sdkconfig.defaults.c6 (che a sua volta viene da quella dell'S3) con le sole differenze del C3: RISC-V un solo core 160 MHz, 400 KB SRAM,
# NESSUNA PSRAM, USB Serial/JTAG. Si usa con: VOS_CFG=c3 (idf/CMakeLists.txt sceglie sdkconfig.defaults.$VOS_CFG e dependencies.lock.c3).
# Stessa partitions.csv (4 MB). TOLTO come per il C6: CONFIG_SPIRAM*, ULP_COPROC*, *_AFFINITY_CPU0, WDT_CHECK_IDLE_TASK_CPU1, USB_HOST_*,
# LCD_RGB_RESTART_IN_VSYNC, ESP_SLEEP_GPIO_RESET_WORKAROUND. Nessun 802.15.4/Thread nel C3. Nomi controllati nel soc_caps.h e nei Kconfig di
# ~/esp/esp-idf (GCMP e CSI hanno SOC_WIFI_GCMP_SUPPORT e SOC_WIFI_CSI_SUPPORT a 1 sul C3); NON verificato che reconfigure non li cambi.
# DA VERIFICARE alla prima build: flash QIO a 80 MHz sulla flash nel package; gradino CPU 80 MHz con esp_pm; memoria libera (400 KB).
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# --- Scheda: ESP32-C3 SuperMini, flash 4 MB, tabella delle partizioni con recovery, rollback ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Compilatore: dimensione piccola, asserzioni silenziose, eccezioni C++ ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_HEAP_POISONING_LIGHT=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y

# --- Bluetooth LE: come l'S3 (solo periferica NimBLE, 1 collegamento), adattato al C3 (13/11/2026, NON compilato) ---
# Il C3 ha il controller BLE 5 integrato (SOC_BLE_50_SUPPORTED nel soc_caps.h di IDF; nome Kconfig BT_CONTROLLER_*, scelto da solo) e NON ha PSRAM:
# tutta la memoria di NimBLE (blocchi mbuf, pile, controller) sta nei 400 KB di SRAM (il C6 ne ha 512). Per questo i valori sono quelli prudenti dell'S3 (1 collegamento, niente
# ruoli centrale/osservatore) e BLE 5 esteso spento (meno buffer: lo usa solo l'annuncio semplice di vos_drv_ble.cpp).
# Non copiato dall'S3: CONFIG_BLE_MESH (BLE Mesh non e il nostro mesh, che usa ESP-NOW) e le CONFIG_SPIRAM*.
# MSYS e buffer ACL restano ai valori di fabbrica IDF 5.5.5 per il C3 (MSYS_1 24x128 + MSYS_2 24x320): da ridurre solo dopo
# aver misurato la RAM libera con il Bluetooth acceso.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n


CONFIG_RTC_CLK_CAL_CYCLES=576
CONFIG_PM_ENABLE=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=n
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048
# 1.8.23g: 3584 = default di Espressif (Kconfig esp_timer, minimo 2048); a 8192 ne usava 56 byte (ram audit, 1.8.23f)
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3584
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1024
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3120
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=2048

# --- Watchdog: task 30 s, interrupt 1000 ms, panico se scatta ---
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y

# --- Console, panico e coredump ---
# 16/11/2026 (utente): core dump SPENTO per ora. Prima era su flash ma la tabella delle partizioni non ha la partizione data,coredump: non salvava nulla
# (guida api-guides/core_dump.md righe 63-85, Kconfig espcoredump riga 3-23). Il rapporto di crash resta quello nostro in RTC (core/vos_crash.cpp).
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# --- Wi-Fi ---
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
# 14/11/2026 (1.8.23c): buffer ridotti SOLO sul C3 (RAM libera con un client collegato: 6 KB). Vincoli di wifi_init.c (#error se violati):
# RX_BA_WIN <= DYNAMIC_RX e RX_BA_WIN <= 2 x STATIC_RX (8 <= 16 e 8 <= 8: ok). Il Kconfig consiglia STATIC_RX >= RX_BA_WIN (qui 4 < 8: solo consiglio).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=8
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_FTM_ENABLE=n
CONFIG_ESP_WIFI_GCMP_SUPPORT=y

# --- Rete: LWIP, SNTP, ethernet SPI ---
CONFIG_ETH_SPI_ETHERNET_DM9051=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=y
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_CHECK_THREAD_SAFETY=y
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_IPV4_NAPT=n
CONFIG_LWIP_DHCP_OPTIONS_LEN=128
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
# 15/11/2026 (utente): RDNSS spento, un router non deve sostituire i DNS IPv4; attivabile in futuro (vedi registro)
CONFIG_LWIP_IPV6_RDNSS_MAX_DNS_SERVERS=0
CONFIG_LWIP_IPV6_DHCP6=y
CONFIG_LWIP_TCP_SYNMAXRTX=6
CONFIG_LWIP_TCP_MSS=1436
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=0
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_RTO_TIME=3000
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_IPV6_ND6_ROUTE_INFO_OPTION_SUPPORT=y
CONFIG_LWIP_PPP_SUPPORT=n
# ICMP e socket raw: servono al comando "ping" (sessioni esp_ping di lwIP). E gia il valore di fabbrica: la riga lo rende esplicito, non cambia la configurazione.
CONFIG_LWIP_ICMP=y
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_BROADCAST_PING=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
# Opzione 15 del DHCP (dominio della rete): la funzione lwip_dhcp_on_extra_option() sta in drivers/vos_drv_dhcp.cpp
CONFIG_LWIP_HOOK_DHCP_EXTRA_OPTION_CUSTOM=y
CONFIG_LWIP_SNTP_UPDATE_DELAY=10800000
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_DEFAULT=y
CONFIG_LWIP_HOOK_NETCONN_EXT_RESOLVE_DEFAULT=y

# --- TLS e server HTTPS (mbedTLS, session ticket 4 ore = 14400 s) ---
CONFIG_ESP_TLS_SERVER_SESSION_TICKETS=y
CONFIG_ESP_TLS_SERVER_SESSION_TICKET_TIMEOUT=14400
CONFIG_ESP_HTTP_CLIENT_ENABLE_BASIC_AUTH=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# 14/11/2026 (1.8.23c), SOLO C3: record TLS in ingresso al massimo 8 KB (prima 16 KB), in uscita resta 4096 (default). Un client che spedisce record da 16 KB viene rifiutato.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_CAMELLIA_C=y
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_HKDF_C=y

# --- Periferiche, file system, flash ---
CONFIG_I2S_ISR_IRAM_SAFE=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_CODEPAGE_850=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_SPI_FLASH_ERASE_YIELD_DURATION_MS=10
CONFIG_SPI_FLASH_ERASE_YIELD_TICKS=2
CONFIG_SPI_FLASH_WRITE_CHUNK_SIZE=4096

# Pacchetto certificati ridotto (CMN, 43 autorita: GitHub, Let's Encrypt, DigiCert, Sectigo, Google, Amazon...): risparmia circa 51 KB (15/11/2026)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Il pacchetto completo e spento
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
