 /**
+ * @brief Decode and relocate ELF data (public entry).
+ *
+ * VOS PATCH 2 (prova 4): se la rilocazione fallisce, il caricatore originale
+ * restituisce l'errore SENZA liberare .text e dati gia allocati (chi chiama
+ * deve ricordarsi esp_elf_deinit). Qui li liberiamo noi: esp_elf_deinit e
+ * innocuo se richiamato dopo (azzera la struttura, i puntatori sono NULL).
+ */
+int esp_elf_relocate(esp_elf_t *elf, const uint8_t *pbuf, size_t size)
+{
+    int ret = esp_elf_relocate_inner(elf, pbuf, size);
+
+    if (ret && elf) {
+        esp_elf_deinit(elf);
+    }
+
+    return ret;
+}
