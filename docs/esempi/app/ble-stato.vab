[manifest]
name=ble-stato
title=Bluetooth stato
version=1
author=VesevOS
use=ble,temp
who=admin

[icon]
<svg viewBox="0 0 24 24"><path d="M7 7l10 10-5 5V2l5 5L7 17" fill="none" stroke="#2c6fbb" stroke-width="2"/></svg>

[page]
text id=info label="Stato"

[code]
# Espone due caratteristiche Bluetooth (serve un telefono con un'app generica per BLE):
#   stato = SOLA LETTURA: temperatura del chip e secondi di attivita della scheda (niente IP, niente nomi, niente segreti)
#   ping  = il telefono scrive un testo qualunque, la scheda risponde "ok" (nel valore e, se il telefono e iscritto, con una notifica)
# Il Bluetooth resta acceso 30 minuti, poi si spegne da solo. Il telefono deve ABBINARSI col codice che l'Admin legge con
# lo script ble.vsb (script run ble): senza abbinamento non si legge e non si scrive niente.
var SVC = '5b0a1000-7665-7365-766f-730000000001'
var STATO = '5b0a1001-7665-7365-766f-730000000001'
var PING = '5b0a1002-7665-7365-766f-730000000001'

def spento()
  var s = ble_status()
  return size(s) >= 3 && s[0..2] == 'off'
end

def aggiorna()
  if spento()
    return nil
  end
  ble_set(STATO, str(temp()) + ' C, ' + str(millis() / 1000) + ' s')
end

def on_write(u, d)
  if u == PING && !spento()
    ble_set(PING, 'ok')
    try
      ble_notify(PING, 'ok')
    except ..
      dev_set('info', 'notifica non inviata')
    end
  end
end

def on_tick()
  aggiorna()
  dev_set('info', spento() ? 'Bluetooth spento' : 'Bluetooth acceso')
end

ble_name('VesevOS stato')
ble_service(SVC, STATO, 'r', PING, 'rwn')
ble_adv(true)
ble_on(30)
aggiorna()

[data]
info=Avvio
