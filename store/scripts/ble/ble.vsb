# Stato del Bluetooth e codice di abbinamento. Solo per l'Admin: lancialo con "script run ble" (o dalla pagina Script).
# Il codice a 6 cifre cambia a ogni accensione. Non scriverlo da nessuna parte e non mandarlo fuori dalla scheda.
# In futuro sara un comando in /sbin; oggi si avvia come ogni script.
print(ble_status())
var codice = ble_passkey()
if codice == nil
  print('Bluetooth spento: nessun codice')
else
  print('Codice di abbinamento: ' + codice)
end
